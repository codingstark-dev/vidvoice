# vidvoice configuration.
#
# Copy to .env and fill in the two keys:
#     cp .env.example .env
#
# vidvoice searches upwards from the current directory for .env, so putting it
# at the root of your project is enough. Real environment variables override
# anything set here.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# https://aistudio.google.com/apikey
# Used to watch the video and produce the timed script.
GEMINI_API_KEY=

# https://play.cartesia.ai/keys
# Used to synthesise the voice. Admin keys (sk_car_admin_...) are rejected by
# the TTS endpoint -- use a regular key.
CARTESIA_API_KEY=


# ---------------------------------------------------------------------------
# Models (optional -- defaults are current as of the 2026-08 API versions)
# ---------------------------------------------------------------------------

# Any current Gemini video-capable model.
# VIDVOICE_GEMINI_MODEL=gemini-3.8-flash

# The 2026-08-14 TTS spec accepts: sonic-3.6 | sonic-3.5 | sonic-3 | sonic-latest
# VIDVOICE_CARTESIA_MODEL=sonic-3.6

# Pinned by the API; the spec's enum accepts only this value today.
# VIDVOICE_CARTESIA_VERSION=2026-08-14


# ---------------------------------------------------------------------------
# Voice and delivery
# ---------------------------------------------------------------------------

# Find ids with: vidvoice voices
# Default is "Skylar", an official en-US voice.
# VIDVOICE_CARTESIA_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4

# One of Cartesia's 58 emotions. Run `vidvoice emotions` for the list.
# Leave empty to let the model read the emotional subtext of the text itself.
# VIDVOICE_EMOTION=calm

# Speaking rate, 0.6-1.5. This is Cartesia's own rate control, applied before
# any time-stretching, so small changes here sound better than big ones later.
# VIDVOICE_SPEECH_SPEED=1.0

# Volume, 0.5-2.0.
# VIDVOICE_SPEECH_VOLUME=1.0


# ---------------------------------------------------------------------------
# Length matching
# ---------------------------------------------------------------------------

# Narration pace used to work out how many words fit in the video. The script
# is budgeted against this before it is written, which is the cheapest way to
# make the narration match the video length.
# VIDVOICE_TARGET_WPM=150

# exact   - converge on the video's duration (default)
# natural - only make gentle rate adjustments
# off     - never change the speaking rate
# VIDVOICE_FIT_MODE=exact


# ---------------------------------------------------------------------------
# Audio and files
# ---------------------------------------------------------------------------

# Cartesia accepts 8000 | 16000 | 22050 | 24000 | 44100 | 48000.
# VIDVOICE_SAMPLE_RATE=48000

# 2 = stereo, 1 = mono.
# VIDVOICE_CHANNELS=2

# Where intermediate artefacts (scripts, timelines, cached voice clips) live.
# Default is a stable per-user cache directory so that a global `vidvoice`
# command does not scatter work folders into every directory you run it from:
#   macOS   ~/Library/Caches/vidvoice
#   Linux   $XDG_CACHE_HOME/vidvoice or ~/.cache/vidvoice
# Set this to keep a project's files together instead.
# VIDVOICE_WORK_DIR=./vidvoice-work
